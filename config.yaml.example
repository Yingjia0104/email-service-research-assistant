# 配置文件模板
# 复制为 config.yaml 并填入你的配置

# API密钥 (调用接口需要)
api_key: "your-secret-key"

# 主模型配置（默认示例：Qwen3-Max）
llm:
  api_key: "your-primary-llm-api-key"
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  model: "qwen3-max"
  supports_vision: true

# 第一备用模型配置（默认示例：国内 Kimi）
llm_backup:
  api_key: "your-backup-api-key"
  base_url: "https://api.moonshot.cn/v1"
  model: "kimi-k2.5"
  supports_vision: true

# 第二备用模型配置（默认示例：海外 Kimi）
llm_backup2:
  api_key: "your-backup2-api-key"
  api_key_env: ""
  base_url: "https://api.moonshot.ai/v1"
  model: "kimi-k2.5"
  supports_vision: true

# 第三备用模型配置（默认示例：GPT-5.4）
llm_backup3:
  api_key: ""
  api_key_env: "OPENAI_API_KEY"
  base_url: "https://api.openai.com/v1"
  model: "gpt-5.4"
  supports_vision: true
  reasoning_effort: "medium"

# 发送方 (Gmail/Outlook SMTP) - 完整闭环时配置；通常可与 IMAP 使用同一个邮箱
smtp:
  host: "smtp.gmail.com"
  port: 587
  use_ssl: false
  timeout_seconds: 30
  email: "your-email@gmail.com"
  password: "your-app-password"

# 收取方 (Gmail/Outlook IMAP)
imap:
  host: "imap.gmail.com"
  port: 993
  email: "your-email@gmail.com"
  password: "your-app-password"

# 目标邮箱 (处理后发送到哪里；完整闭环时配置，通常可直接填同一个邮箱)
target:
  email: "destination@example.com"

# 邮件过滤配置
filters:
  # 只接收这些后缀的邮件，为空则不限制
  allowed_senders:
    - "@morganstanley.com"
    - "@jpmorgan.com"
    - "@goldmansachs.com"
    - "@bofa.com"
    - "@ubs.com"
  # 联调时可选：忽略某个本地时间点之前的历史邮件
  # received_after_local: "2026-03-16T19:22:21+08:00"


server:
  # 安全起见默认仅监听本机；如需局域网访问请自行改为 0.0.0.0 并配防火墙/VPN
  host: "127.0.0.1"
  port: 8877

background:
  enabled: true
  interval_minutes: 15
  limit: 20
  # DDL 定时分析；early run 仍要求本轮 session 内白名单 sales 到齐 + 邮件数阈值 + quiet period
  analysis_enabled: true
