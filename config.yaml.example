# 配置文件模板
# 复制为 config.yaml 并填入你的配置

# API密钥 (调用接口需要)
api_key: "your-secret-key"

# Kimi (Moonshot AI) 大模型配置
kimi:
  api_key: "your-kimi-api-key"
  base_url: "https://api.moonshot.cn/v1"
  model: "kimi-k2.5"

# 发送方 (Gmail SMTP)
smtp:
  host: "smtp.gmail.com"
  port: 587
  email: "your-email@gmail.com"
  password: "your-app-password"

# 收取方 (Gmail IMAP)
imap:
  host: "imap.gmail.com"
  port: 993
  email: "your-email@gmail.com"
  password: "your-app-password"

# 目标邮箱 (处理后发送到哪里)
target:
  email: "destination@example.com"

# 邮件过滤配置
filters:
  # 只接收这些后缀的邮件，为空则不限制
  allowed_senders:
    - "@morganstanley.com"
    - "@jpmorgan.com"
    - "@goldmansachs.com"

server:
  host: "0.0.0.0"
  port: 8877
