# 配置文件模板
# 复制为 config.yaml 并填入你的配置

# API密钥 (调用接口需要)
api_key: "your-secret-key"

# Kimi (Moonshot AI) 大模型配置
kimi:
  api_key: "your-kimi-api-key"
  base_url: "https://api.moonshot.cn/v1"
  model: "kimi-k2.5"
  supports_vision: true

# 备用 API 配置（当前API余额不足时自动切换）
kimi_backup:
  api_key: "your-backup-api-key"
  base_url: "https://api.moonshot.cn/v1"
  model: "kimi-k2.5"
  supports_vision: true

# 发送方 (Gmail/Outlook SMTP) - 完整闭环时配置；通常可与 IMAP 使用同一个邮箱
smtp:
  host: "smtp.gmail.com"
  port: 587
  use_ssl: false
  timeout_seconds: 30
  email: "your-email@gmail.com"
  password: "your-app-password"

# 收取方 (Gmail/Outlook IMAP)
imap:
  host: "imap.gmail.com"
  port: 993
  email: "your-email@gmail.com"
  password: "your-app-password"

# 目标邮箱 (处理后发送到哪里；完整闭环时配置，通常可直接填同一个邮箱)
target:
  email: "destination@example.com"

# 邮件过滤配置
filters:
  # 只接收这些后缀的邮件，为空则不限制
  allowed_senders:
    - "@morganstanley.com"
    - "@jpmorgan.com"
    - "@goldmansachs.com"
    - "@bofa.com"
    - "@ubs.com"
  # 联调时可选：忽略某个本地时间点之前的历史邮件
  # received_after_local: "2026-03-16T19:22:21+08:00"


server:
  # 安全起见默认仅监听本机；如需局域网访问请自行改为 0.0.0.0 并配防火墙/VPN
  host: "127.0.0.1"
  port: 8877

background:
  enabled: true
  interval_minutes: 15
  limit: 20
  # DDL 定时分析；如仅想依赖“全员到齐即提前触发 daily”，可临时设为 false
  analysis_enabled: true
